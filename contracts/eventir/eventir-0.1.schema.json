{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonweave.dev/schemas/eventir/0.1.json",
  "title": "ReasonWeave EventIR 0.1",
  "type": "object",
  "required": [
    "schema_version",
    "event",
    "subjects"
  ],
  "properties": {
    "schema_version": {
      "const": "eventir/0.1"
    },
    "event": {
      "$ref": "#/$defs/event"
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "default": []
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "default": []
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      },
      "default": []
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "default": []
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timeRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "geoLocation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracy_m": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reference_code": {
          "type": "string",
          "pattern": "^EVT-[A-Za-z0-9-]+$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "occurred_at": {
          "$ref": "#/$defs/timeRange"
        },
        "location": {
          "$ref": "#/$defs/geoLocation"
        },
        "domain_pack": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "SUPPORTED",
            "CONTRADICTED",
            "WITHDRAWN"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "reliability": {
          "type": [
            "number",
            "string"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "captured_location": {
          "$ref": "#/$defs/geoLocation"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "evidence_id",
        "predicate",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "value": {},
        "model_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "VERIFIED",
            "REJECTED",
            "MODIFIED"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "score_band": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "UNCERTAIN",
            "WEAK",
            "CONTRADICTED"
          ]
        },
        "evidence_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "generated_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
