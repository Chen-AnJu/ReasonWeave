{
  "name": "@reasonweave/domain-pack-cli",
  "version": "0.4.1",
  "description": "Validate, package, verify, install, and list ReasonWeave Domain Packs.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/**/*.mjs",
    "src/**/*.json",
    "README.md"
  ],
  "bin": {
    "rwpack": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "reasonweave",
    "domain-pack",
    "evidence-reasoning"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tar": "^7.5.1",
    "yaml": "^2.8.1"
  }
}
