{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonweave.dev/contracts/model/vision-observations-1.schema.json",
  "title": "ReasonWeave Vision Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["observations", "limitations"],
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "value", "confidence", "description"],
        "properties": {
          "predicate": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,159}$"
          },
          "value": {
            "type": ["boolean", "number", "string"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
