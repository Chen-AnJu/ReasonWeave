{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonweave.dev/schemas/observation-bundle/1.0.json",
  "title": "ReasonWeave Observation Bundle 1.0",
  "type": "object",
  "required": ["schema_version", "domain_pack", "event_type", "subject", "evidence_items"],
  "properties": {
    "schema_version": { "const": "observation-bundle/1.0" },
    "domain_pack": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}/[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "event_type": { "type": "string", "minLength": 1, "maxLength": 64 },
    "target_version": { "type": "string", "maxLength": 64 },
    "subject": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "attributes": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["external_id", "source_type", "captured_at", "observations"],
        "properties": {
          "external_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "source_type": { "type": "string", "minLength": 1, "maxLength": 64 },
          "captured_at": { "type": "string", "format": "date-time" },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["predicate", "value", "confidence", "source_locator"],
              "properties": {
                "predicate": { "type": "string", "minLength": 1, "maxLength": 160 },
                "value": {},
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "description": { "type": "string", "maxLength": 1000 },
                "source_locator": { "type": "object", "additionalProperties": true }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
