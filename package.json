{
  "name": "reasonweave",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "verify:open-source": "node ./scripts/verify-open-source-readiness.mjs",
    "verify:clean-clone": "node ./scripts/verify-clean-clone.mjs",
    "package:source": "node ./scripts/package-source.mjs",
    "clean:generated": "node ./scripts/clean-generated.mjs",
    "init": "node ./scripts/init-local-config.mjs",
    "cli:test": "pnpm --dir tools/domain-pack-cli test && pnpm --dir tools/evidence-cli test",
    "example:test": "node --test examples/quickstart/*.test.mjs",
    "example:kubernetes": "node ./examples/quickstart/run.mjs --scenario kubernetes",
    "example:cold-holding": "node ./examples/quickstart/run.mjs --scenario cold-holding",
    "cli:pack": "node ./scripts/package-cli.mjs",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:check": "pnpm --dir frontend lint && pnpm --dir frontend typecheck",
    "frontend:test": "pnpm --dir frontend test",
    "frontend:e2e": "pnpm --dir frontend test:e2e",
    "frontend:e2e:real": "pnpm --dir frontend test:e2e:real",
    "frontend:build": "pnpm --dir frontend build",
    "backend:test": "node ./scripts/test-backend.mjs",
    "api:contract:export": "node ./scripts/export-openapi.mjs",
    "api:types:check": "node ./scripts/verify-openapi-types.mjs",
    "rwpack": "node ./tools/domain-pack-cli/src/cli.mjs",
    "rw-evidence": "node ./tools/evidence-cli/src/cli.mjs"
  }
}
